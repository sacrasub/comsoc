{
  "version": 2,
  "name": "comsoc-cft",
  "buildCommand": null,
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/agenda-cft",
      "dest": "/Agenda-CFT/index.html"
    },
    {
      "src": "/agenda-cft/",
      "dest": "/Agenda-CFT/index.html"
    },
    {
      "src": "/votacao",
      "dest": "/votacao.html"
    },
    {
      "src": "/votacao/",
      "dest": "/votacao.html"
    },
    {
      "src": "/(.*\\.(js|css|html|png|jpg|jpeg|svg|ico|webp|woff|woff2|ttf|eot))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",        "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",     "value": "camera=(), microphone=()" }
      ]
    },
    {
      "source": "/js/(.*\\.js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*\\.css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    }
  ]
}
